/frontend/node_modules/
/frontend/staticfiles/

# Webpack build output. Regenerated by `npm run build` (and by the
# frontend-build stage in Dockerfile), so it is never committed.
# frontend/static/img is source and stays tracked.
/frontend/static/css/
/frontend/static/fonts/
/frontend/static/js/

# Webpack hot-update files (development only)
*.hot-update.js
*.hot-update.json

# Docker environment files (contain secrets)
.env.dev.local
.env.dev.prod-db
backend/.env.docker.local
backend/.env.docker.prod-db

# Docker volumes
postgres_data/
/MANUAL_DEPLOYMENT.md
/DEPLOYMENT_GUIDE.md
/STRIPE_SETUP.md
/PAYMENT_FLOW_EXPLANATION.md
/PAYMENT_IMPLEMENTATION_SUMMARY.md
# Testing artifacts
/coverage/
/htmlcov/
/playwright-report/
/test-results/
.pytest_cache/
coverage.xml
test_output*.txt
*.log

# Agent and Tool artifacts
.gemini/
.beads/
.claude/
.ropeproject/
# Python cache and coverage
.coverage
*.coverage
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
